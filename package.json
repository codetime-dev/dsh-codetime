{
  "name": "dsh-codetime",
  "description": "CodeTime backend for the DeepSeek Harness session-telemetry seam: reports session/turn/tool/file activity to codetime.dev via /v3/agent/ingest",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codetime-dev/dsh-codetime.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/cordis-plugin-timer": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-telemetry": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-timer": "~1.1.6",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.2.0-rc.2"
  }
}
